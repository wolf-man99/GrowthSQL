{
  "name": "tiramisu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "(npm run warehouse || echo 'warehouse prebuild skipped -- will build in-memory at runtime') && npm run monaco",
    "warehouse": "tsx scripts/build-warehouse.ts",
    "db:push": "prisma db push --skip-generate --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "predev": "npm run setup",
    "dev": "next dev",
    "prebuild": "npm run setup",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run smoke && npm run validate:content && npm run validate:simulator && npm run validate:missions",
    "postinstall": "prisma generate",
    "monaco": "tsx scripts/copy-monaco.ts",
    "validate:simulator": "tsx scripts/validate-simulator.ts",
    "validate:missions": "tsx scripts/validate-missions.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.30.0",
    "monaco-editor": "^0.53.0",
    "next": "^16.3.0",
    "posthog-js": "^1.168.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "recharts": "^2.15.4",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "description": "Zero to independent BigQuery marketing analysis in 14 days."
}
