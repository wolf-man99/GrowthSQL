// Learner state. The marketing warehouse the learner *queries* is a separate,
// read-only database. See docs/DATA-MODEL.md.
//
// v1 has a single local profile (`id = "local"`), but every table is keyed by
// profileId so adding auth later is a drop-in change rather than a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A learner account. Platform-wide gamification (XP, level, streak) lives here;
/// per-course content progress is scoped by courseId on the child tables.
model Profile {
  id             String   @id @default(cuid())
  // Auth
  email          String?  @unique
  passwordHash   String? // null for OAuth-only accounts
  provider       String   @default("credentials") // credentials | google
  googleId       String?  @unique
  emailVerified  Boolean  @default(false)
  image          String? // avatar URL (from Google, say)
  // Profile
  displayName    String   @default("Analyst")
  avatarSeed     String   @default("northbeam")
  timezone       String   @default("UTC")
  referralCode   String?  @unique // for share-to-friends invites
  // Onboarding: nullable in the DB (existing/seeded rows predate these), required
  // by application-level signup validation for every new account going forward.
  phone          String?
  courseInterest String? // a Course.id from the registry
  learningGoal   String? // why they're here: fixed set, see AuthForm's ONBOARDING_GOALS
  heardFrom      String? // acquisition channel: fixed set, see AuthForm's ONBOARDING_SOURCES
  // Platform-wide gamification
  xp             Int      @default(0)
  coins          Int      @default(0)
  level          Int      @default(1)
  title          String   @default("Curious")
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  streakFreezes  Int      @default(2)
  lastActiveDate String? // ISO date; drives streak maths
  dailyGoalXp    Int      @default(150)
  isDemo         Boolean  @default(false) // the seeded showcase profile
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lessonProgress LessonProgress[]
  attempts       Attempt[]
  conceptStats   ConceptStat[]
  badges         BadgeAward[]
  bookmarks      Bookmark[]
  notes          Note[]
  cardReviews    CardReview[]
  dailyActivity  DailyActivity[]
  enrollments    Enrollment[]
  payments       Payment[]
  simAccounts    SimAccount[]
  missionRuns    MissionRun[]
}

/// One row per (profile, course) a learner has started.
model Enrollment {
  id               String    @id @default(cuid())
  profileId        String
  courseId         String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  lastActive       DateTime  @default(now())
  // Set once, the moment every "Learn" lesson in this course is first passed, the
  // progress half of the Run gate. Independent of payment: isRunUnlocked() requires
  // this AND runPurchasedAt below, so finishing the lessons doesn't skip paying and
  // paying doesn't skip finishing the lessons.
  runUnlockedAt    DateTime?
  // Payment entitlements. Set by a verified Razorpay payment (see the Payment model)
  // for the 'learn'/'bundle' and 'run'/'bundle' products respectively, a bundle
  // purchase sets both in the same transaction. Modules past the free preview check
  // learnPurchasedAt; isRunUnlocked() checks runPurchasedAt alongside runUnlockedAt.
  learnPurchasedAt DateTime?
  runPurchasedAt   DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, courseId])
  @@index([courseId])
}

/// An auditable record of one Razorpay checkout attempt. Both the client-side verify
/// call and the webhook write to the same row (keyed on razorpayOrderId/PaymentId),
/// so a duplicate delivery from either path is a no-op rather than a double-grant.
model Payment {
  id                String    @id @default(cuid())
  profileId         String
  courseId          String // 'meta-ads' today; kept generic like Enrollment.courseId
  product           String // learn | run | bundle
  amount            Int // paise (₹499 = 49900), Razorpay's unit
  currency          String    @default("INR")
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  status            String    @default("created") // created | paid | failed
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// One row per (day, section). The ten beats of a day page.
model LessonProgress {
  id          String    @id @default(cuid())
  profileId   String
  courseId    String    @default("sql-for-marketers")
  dayNumber   Int
  section     String
  status      String    @default("in_progress") // in_progress | complete
  score       Float? // 0..1 for scored sections
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, courseId, dayNumber, section])
  @@index([profileId, courseId, dayNumber])
}

/// Every graded submission, pass or fail. The raw material for all analytics.
model Attempt {
  id           String   @id @default(cuid())
  profileId    String
  courseId     String   @default("sql-for-marketers")
  itemType     String // exercise | quiz | assessment | project | interview | capstone | lab | challenge
  itemId       String
  sql          String   @default("")
  passed       Boolean  @default(false)
  ms           Int      @default(0)
  rowsReturned Int      @default(0)
  hintsUsed    Int      @default(0)
  revealed     Boolean  @default(false)
  diagnosis    String? // coach diagnosis code, for the mistake taxonomy
  xpAwarded    Int      @default(0)
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, itemType])
  @@index([profileId, itemId])
  @@index([profileId, createdAt])
}

/// Rolling mastery per concept, feeds weak-area detection and revision.
model ConceptStat {
  id         String   @id @default(cuid())
  profileId  String
  courseId   String   @default("sql-for-marketers")
  concept    String
  attempts   Int      @default(0)
  passes     Int      @default(0)
  firstTryOk Int      @default(0)
  totalMs    Int      @default(0)
  mastery    Float    @default(0) // 0..1, decayed by recency
  lastSeenAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, courseId, concept])
  @@index([profileId, courseId, mastery])
}

model BadgeAward {
  id        String   @id @default(cuid())
  profileId String
  badgeId   String
  awardedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeId])
}

model Bookmark {
  id        String   @id @default(cuid())
  profileId String
  itemType  String
  itemId    String
  label     String   @default("")
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, itemType, itemId])
}

model Note {
  id        String   @id @default(cuid())
  profileId String
  itemType  String
  itemId    String
  body      String   @default("")
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, itemType, itemId])
}

/// Flashcard content is seeded, not user-authored.
model Flashcard {
  id      String @id
  deck    String
  front   String
  back    String
  concept String

  reviews CardReview[]
}

/// SM-2 scheduling state, one row per (profile, card).
model CardReview {
  id           String   @id @default(cuid())
  profileId    String
  cardId       String
  ease         Float    @default(2.5)
  intervalDays Int      @default(0)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  dueDate      String // ISO date
  lastGrade    Int?
  updatedAt    DateTime @updatedAt

  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  card    Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([profileId, cardId])
  @@index([profileId, dueDate])
}

/// Simulated leaderboard opponents. They progress on a curve so the board moves.
model Rival {
  id          String @id
  displayName String
  avatarSeed  String
  country     String
  baseXp      Int
  dailyXp     Int
  streak      Int
  level       Int
  title       String
}

model DailyActivity {
  id                String @id @default(cuid())
  profileId         String
  date              String // ISO date
  xpEarned          Int    @default(0)
  exercisesSolved   Int    @default(0)
  exercisesFailed   Int    @default(0)
  minutesActive     Int    @default(0)
  accuracyNumerator Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId, date])
}

// ─────────────────────────────────────────────────────────── Run simulator ──
//
// The Run tier's account state. Deliberately not one table per entity: every read
// is "this one learner's account", so the settings tree lives as a JSON document
// and only the daily metrics, which need aggregating across ranges, get rows.

/// One simulated ad account: either a mission run or the open sandbox.
model SimAccount {
  id         String   @id @default(cuid())
  profileId  String
  courseId   String // 'meta-ads'
  /// Null for the free-play sandbox; otherwise the mission this account is running.
  missionId  String?
  /// Days elapsed since the account opened. Advanced by the tick, never by wall clock.
  currentDay Int      @default(0)
  status     String   @default("active") // active | complete | abandoned
  /// Every random draw derives from this, so a run replays identically.
  seed       Int
  /// SimState from src/lib/simulator/engine/types.ts: campaigns, ad sets, ads,
  /// audiences, account conditions, and each entity's cumulative runtime counters.
  state      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile  Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  days     SimDay[]
  segments SimDaySegment[]

  @@index([profileId, courseId])
}

/// One entity's numbers for one simulated day. Written once per tick and never
/// updated, so the dashboard's date ranges aggregate over immutable history.
model SimDay {
  id          String @id @default(cuid())
  accountId   String
  day         Int
  /// Entity this row describes, or '__account__' for the account-level rollup.
  entityId    String
  entityLevel String // account | campaign | adset | ad
  spend       Int    @default(0)
  impressions Int    @default(0)
  linkClicks  Int    @default(0)
  purchases   Int    @default(0)
  revenue     Int    @default(0)
  reach       Int    @default(0)

  account SimAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, day, entityId])
  @@index([accountId, day])
  @@index([accountId, entityId])
}

/// One ad set's day, broken out by who saw it and where.
///
/// Written at ad set level only: the audience and the placement mix both belong
/// there, so campaign and account breakdowns are sums of these rows rather than
/// separately-computed figures that could drift out of agreement with them. Each
/// dimension partitions the same delivery, so summing any one of them reproduces
/// the matching SimDay row exactly.
model SimDaySegment {
  id          String @id @default(cuid())
  accountId   String
  day         Int
  /// The ad set this describes.
  entityId    String
  dimension   String // age | gender | placement
  /// The band itself: '25–34', 'Women', 'Instagram Reels'.
  segment     String
  spend       Int    @default(0)
  impressions Int    @default(0)
  linkClicks  Int    @default(0)
  purchases   Int    @default(0)
  revenue     Int    @default(0)

  account SimAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, day, entityId, dimension, segment])
  @@index([accountId, day])
}

/// A learner's attempt at one mission, and how it was graded.
model MissionRun {
  id         String    @id @default(cuid())
  profileId  String
  missionId  String
  accountId  String?
  status     String    @default("in_progress") // in_progress | passed | failed
  score      Int?
  /// Per-objective pass/fail plus the measured value, for the debrief screen.
  objectives Json?
  startedAt  DateTime  @default(now())
  gradedAt   DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, missionId])
  @@index([profileId])
}
